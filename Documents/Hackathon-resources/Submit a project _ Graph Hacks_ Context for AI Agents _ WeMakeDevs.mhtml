; padding-top: 1.75rem; font-size: 1.75rem; }

.blog-prose h3 { margin: 2.25rem 0px 0.75rem; font-size: 1.3125rem; }

.blog-prose h4 { margin: 1.75rem 0px 0.5rem; font-size: 1.0625rem; }

.blog-prose :is(h2, h3, h4) > a { color: inherit; text-decoration: none; }

.blog-prose :is(h2, h3, h4) > a::after { content: "#"; color: var(--color-t=
heme-2-light); opacity: 0; margin-left: 0.4em; transition: opacity 0.15s; }

.blog-prose :is(h2, h3, h4) > a:hover::after, .blog-prose :is(h2, h3, h4) >=
 a:focus-visible::after { opacity: 1; }

.blog-prose p { text-wrap: pretty; margin: 1.25rem 0px; }

.blog-prose strong { color: var(--foreground); font-weight: 600; }

.blog-prose a:not(:is(h2, h3, h4) > a) { color: var(--foreground); text-dec=
oration-line: underline; text-decoration-style: initial; text-decoration-co=
lor: var(--color-theme-2-light); text-underline-offset: 3px; text-decoratio=
