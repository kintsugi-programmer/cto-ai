ight); }

.blog-prose :is(ul, ol) { margin: 1.25rem 0px; padding-left: 1.5rem; }

.blog-prose ul { list-style: outside; }

.blog-prose ol { list-style: decimal; }

.blog-prose li { margin: 0.5rem 0px; }

