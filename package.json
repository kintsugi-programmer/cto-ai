{
  "name": "cto-ai",
  "version": "0.1.0",
  "description": "The persistent project brain for any coding agent - file-first, graph-powered, MCP-native.",
  "type": "module",
  "bin": {
    "ctoai": "dist/cli.js",
    "cto-ai": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests tsup.config.ts vitest.config.ts",
    "format": "biome check --write src tests tsup.config.ts vitest.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "prepare": "npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "cli",
    "context",
    "agents",
    "graph",
    "memory",
    "mcp",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kintsugi-programmer/cto-ai.git",
    "directory": "cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^15.0.0",
    "ignore": "^7.0.12",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
