@charset "utf-8";

.bdt-context-menu .bdt-context { font-size: 0.875rem; list-style: none; mar=
gin: 0px; padding: 0px; position: absolute; min-width: 16em; z-index: 1; op=
acity: 0; visibility: hidden; }

.bdt-context-menu .bdt-context.is-visible { opacity: 1; transform: none; tr=
ansition-delay: 0s, 0s, 0s, 0s; visibility: visible; filter: none; }

.bdt-context-menu .bdt-context.sub { width: max-content; min-width: 10em; l=
eft: 100%; top: 0px; transform: translateX(-0.7em); transition: transform 0=
.4s 0.4s, opacity 0.25s 0.25s, width 0.15s 0.3s, min-width 0.15s 0.3s, visi=
bility 0.01s 0.35s; overflow: hidden; filter: none; }

.bdt-context-menu .bdt-context.sub.oppositeX { right: 100%; left: auto; tra=
nsform: translateX(0.7em); }

.bdt-context-menu .bdt-context.sub.oppositeY { top: auto; bottom: -0.4em; }

.bdt-context-menu .bdt-context > li { position: relative; margin-bottom: 1p=
x; transition: 0.3s; }

.bdt-context-menu .bdt-context > li:nth-last-child(1) { margin-bottom: 0px =
!important; }

.bdt-context-menu .bdt-context > li:hover a { padding-left: 20px; }

.bdt-context-menu .bdt-context > li a { color: rgb(51, 51, 51); text-transf=
orm: uppercase; transition: 0.3s; text-decoration: none; display: inherit; =
letter-spacing: 2px; font-size: 11px; padding: 10px 15px; }

.bdt-context-menu .bdt-context > li a.has-arrow { display: flex; align-item=
s: center; justify-content: space-between; }

.bdt-context-menu .bdt-context > li a.has-arrow i.eicon-caret-right { font-=
size: 15px; }

.bdt-context-menu .bdt-context > li:not(.bdt-context > li.nope):hover .sub =
{ opacity: 1; transform: translateX(0px); transition-delay: 0.2s, 0.25s, 0.=
2s, 0.2s, 0s; visibility: visible; }

.bdt-context-menu .bdt-context .li:nth-of-type(1) { margin-top: 0.5em; }

.bdt-context-menu .bdt-context .li.active { animation: 0.5s ease 0s 1 norma=
l none running flash; }

.bdt-context-menu .hide { display: none; }

.bdt-context-menu .bdt-menu-icon svg { width: 1em; height: 1em; }
